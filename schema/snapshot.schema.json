      "calibration": {
       "type": "number"
      },
      "coolant": {
       "type": "number"
      },
      "fault": {
       "type": "number"
      },
      "fuel": {
       "type": "number"
      },
      "reference": {
       "type": "number"
      },
      "rods": {
       "type": "number"
      },
      "total": {
       "type": "number"
      },
      "xenon": {
       "type": "number"
      }
     },
