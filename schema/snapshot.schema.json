     "type": "number"
    },
    "rejected": {
     "minimum": 0,
     "type": "integer"
    },
    "rhsCalls": {
     "minimum": 0,
     "type": "integer"
    },
    "steps": {
     "minimum": 0,
     "type": "integer"
    }
   },
